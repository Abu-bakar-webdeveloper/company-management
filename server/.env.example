NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/bizflow

# JWT settings (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_ACCESS_EXPIRES_IN=15m
# Session-login refresh TTL. "Remember for 30 days" always uses 30d regardless of this value.
JWT_REFRESH_EXPIRES_IN=7d

# Refresh token cookie
REFRESH_TOKEN_COOKIE_NAME=refreshToken
# Local: COOKIE_SECURE=false, COOKIE_SAME_SITE=lax
# Vercel (API + frontend on different domains): COOKIE_SECURE=true, COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Frontend origin for CORS and invite/reset links
# Local: http://localhost:5173
# Vercel: https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# SMTP (optional in development — invite/reset links are logged to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Display name is applied automatically: "BizFlow" for Super Admin, company name for company emails
MAIL_FROM=noreply@bizflow.com

# Token expiry (hours)
INVITE_TOKEN_EXPIRES_HOURS=72
RESET_TOKEN_EXPIRES_HOURS=24

# Cloudinary (signed client uploads — fill from Cloudinary Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=bizflow/avatars
CLOUDINARY_TASKS_FOLDER=bizflow/tasks
CLOUDINARY_LOGOS_FOLDER=bizflow/logos
CLOUDINARY_PROJECTS_FOLDER=bizflow/projects
CLOUDINARY_EXPENSES_FOLDER=bizflow/expenses

# Web Push (optional — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@bizflow.com
